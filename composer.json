{
    "name": "contenir/formbuilder-laminas-mvc",
    "description": "Laminas MVC adapter for contenir/formbuilder — Laminas\\Db loader, view helper, submit controller, Module + ConfigProvider.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/formbuilder": "^0.1.1 || ^2.0",
        "laminas/laminas-db": "^2.17",
        "laminas/laminas-form": "^3.20",
        "laminas/laminas-http": "^2.19",
        "laminas/laminas-mail": "^2.22",
        "laminas/laminas-mime": "^2.12",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-servicemanager": "^3.0",
        "laminas/laminas-session": "^2.16",
        "laminas/laminas-stdlib": "^3.21",
        "laminas/laminas-view": "^2.30",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/storage": "^0.1.0 || ^2.0",
        "infection/infection": "^0.34.1",
        "laminas/laminas-i18n": "^2.32",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "contenir/storage": "Enables the file field type: register a Contenir\\Storage\\StorageManager service and uploads are stored on its default profile."
    },
    "autoload": {
        "psr-4": {
            "Contenir\\FormBuilder\\Laminas\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\FormBuilder\\Laminas\\Mvc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "module": "Contenir\\FormBuilder\\Laminas\\Mvc"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
